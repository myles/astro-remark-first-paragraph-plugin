    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
