{
  "name": "@mylesb/astro-remark-first-paragraph-plugin",
  "version": "0.0.0-development",
  "description": "Plugin for Remark to get the first paragraph of a markdown file.",
  "keywords": [
    "remark",
    "remark-plugin",
    "astro",
    "mdast",
    "frontmatter",
    "description",
    "excerpt"
  ],
  "homepage": "https://github.com/myles/astro-remark-first-paragraph-plugin#readme",
  "bugs": {
    "url": "https://github.com/myles/astro-remark-first-paragraph-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myles/astro-remark-first-paragraph-plugin.git"
  },
  "license": "MIT",
  "author": "Myles Braithwaite <myles@myles.garden> (https://myles.garden)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "prettier": "prettier . -c",
    "prettier:write": "prettier . --write",
